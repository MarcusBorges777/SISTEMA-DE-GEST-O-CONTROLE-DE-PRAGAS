# ===== Configuração do Sistema de Gestão =====
# Copie este arquivo para .env e configure as variáveis

# Chave secreta do Flask (gerada automaticamente se não definida)
# FLASK_SECRET_KEY=sua-chave-secreta-aqui

# Ambiente (development ou production)
FLASK_ENV=development

# Google Gemini API Key (obtenha em: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=sua-api-key-aqui

# Usar CSS local compilado (true) ou CDN do Tailwind (false)
USE_LOCAL_CSS=false

# Porta do servidor (padrão: 5000)
# PORT=5000
