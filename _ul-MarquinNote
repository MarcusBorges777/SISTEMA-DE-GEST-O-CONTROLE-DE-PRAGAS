async function enviarPerguntaIA() {
    const input = document.getElementById('ia-input');
    const pergunta = input.value.trim();

    if(!pergunta) return;

    adicionarMensagemIA('usuario', pergunta);
    input.value = '';

    const loadingId = 'loading-' + Date.now();
    adicionarMensagemIA('ia', 'Analisando...', loadingId);

    try {
        const response = await fetch('/api/ia-consulta', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({pergunta: pergunta})
        });

        const resultado = await response.json();
        document.getElementById(loadingId)?.remove();

        if(resultado.sucesso) {
            adicionarMensagemIA('ia', resultado.resposta);
        } else {
            adicionarMensagemIA('ia', '❌ ' + (resultado.erro || 'Erro'));
