<script>
let clientesCache = [];
const apiCache = new Map();  // Cache simples para APIs
let pendingRequests = new Map();  // Prevenir requisições duplicadas

// Função de debounce para otimizar buscas
function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
        const later = () => {
            clearTimeout(timeout);
            func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
}

// Função para requisições com cache e deduplicação
async function cachedFetch(url, options = {}) {
    const cacheKey = `${url}_${JSON.stringify(options)}`;
    const cacheTTL = 30000; // 30 segundos

    // Verificar cache
    if (apiCache.has(cacheKey)) {
        const {data, timestamp} = apiCache.get(cacheKey);
        if (Date.now() - timestamp < cacheTTL) {
            return data;
        }
    }

    // Verificar se já existe requisição pendente
    if (pendingRequests.has(cacheKey)) {
        return pendingRequests.get(cacheKey);
    }

    // Fazer nova requisição
    const promise = fetch(url, options)
        .then(res => res.json())
        .then(data => {
            apiCache.set(cacheKey, {data, timestamp: Date.now()});
            pendingRequests.delete(cacheKey);
            return data;
        })
        .catch(err => {
            pendingRequests.delete(cacheKey);
            throw err;
        });

    pendingRequests.set(cacheKey, promise);
    return promise;
}

// Limpar cache
function clearCache(pattern = null) {
    if (pattern) {
        for (const key of apiCache.keys()) {
            if (key.includes(pattern)) {
                apiCache.delete(key);
            }
        }
    } else {
        apiCache.clear();
    }
}

