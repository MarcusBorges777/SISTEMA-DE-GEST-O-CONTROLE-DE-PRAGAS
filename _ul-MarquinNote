<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Dashboard - Sistema de Gestao</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body { font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial; }

        .toast-container { position: fixed; right: 1rem; bottom: 1rem; z-index: 9999; display: flex; flex-direction: column; gap: 0.5rem; }
        .toast { padding: 1rem; border-radius: 0.5rem; color: white; font-weight: 500; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); animation: slideIn 0.3s ease-out; }
        @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
        .bg-success { background-color: #10b981; }
        .bg-error { background-color: #ef4444; }
        .bg-info { background-color: #4f46e5; }

        .search-global { transition: all 0.3s; }
        .search-global:focus { width: 400px; }
    </style>
</head>
<body class="min-h-full bg-slate-50">

    <!-- NAVBAR -->
    <nav class="sticky top-0 z-40 w-full border-b bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex items-center justify-between py-3">
                <div class="flex items-center gap-6">
                    <a href="/" class="h-16 flex items-center justify-center font-bold text-2xl text-indigo-600 hover:text-indigo-700 transition">SG</a>
                    <div class="hidden sm:flex gap-1">
                        
<button onclick="navigate('dashboard')" id="nav-dashboard" class="px-4 py-2 rounded-md font-medium text-indigo-700 bg-indigo-50">Clientes</button>
<button onclick="navigate('gerador')" id="nav-gerador" class="px-4 py-2 rounded-md font-medium text-slate-600 hover:bg-slate-50">Novo Documento</button>
<button onclick="navigate('arquivos')" id="nav-arquivos" class="px-4 py-2 rounded-md font-medium text-slate-600 hover:bg-slate-50">Arquivos & Documentos</button>
<button onclick="navigate('analise')" id="nav-analise" class="px-4 py-2 rounded-md font-medium text-slate-600 hover:bg-slate-50">Análise</button>
<button onclick="navigate('upload')" id="nav-upload" class="px-4 py-2 rounded-md font-medium text-slate-600 hover:bg-slate-50">Upload</button>
<button onclick="navigate('configuracoes')" id="nav-configuracoes" class="px-4 py-2 rounded-md font-medium text-slate-600 hover:bg-slate-50">
    <i data-lucide="settings" class="w-4 h-4 inline"></i>
</button>

                    </div>
                </div>

                <!-- BARRA DE PESQUISA GLOBAL -->
                <div class="flex items-center gap-3">
                    <div class="relative">
                        <input
                            type="text"
                            id="search-global"
                            placeholder="Pesquisar tudo..."
                            class="search-global w-64 px-4 py-2 pl-10 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm"
                        >
                        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 transform -translate-y-1/2 text-indigo-400"></i>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-8">
        
<!-- VIEW: CLIENTES -->
<section id="view-dashboard">
    <div class="flex flex-col md:flex-row items-center justify-between mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-indigo-950">Gerenciar Clientes</h1>
            <p class="text-sm text-indigo-500">Cadastre, edite e gere documentos para seus clientes</p>
        </div>
        <button onclick="openModalCliente()" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg shadow-md hover:bg-indigo-700 transition">
            <i data-lucide="plus" class="w-5 h-5"></i> Novo Cliente
        </button>
    </div>

    <!-- Filtros -->
    <div class="bg-white rounded-lg border border-indigo-100 p-4 mb-6 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <div>
                <label class="text-xs font-bold uppercase text-indigo-400 mb-1 block">Nome</label>
                <input id="filter-nome" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Buscar...">
            </div>
            <div>
                <label class="text-xs font-bold uppercase text-indigo-400 mb-1 block">Cidade</label>
                <input id="filter-cidade" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Cidade...">
            </div>
            <div>
                <label class="text-xs font-bold uppercase text-indigo-400 mb-1 block">CNPJ</label>
                <input id="filter-cnpj" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="00.000...">
            </div>
            <div>
                <label class="text-xs font-bold uppercase text-indigo-400 mb-1 block">CNAE</label>
                <input id="filter-cnae" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="CNAE...">
            </div>
            <div>
                <label class="text-xs font-bold uppercase text-indigo-400 mb-1 block">Rua</label>
                <input id="filter-rua" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Rua...">
            </div>
        </div>
    </div>

    <!-- Tabela -->
    <div class="bg-white rounded-lg overflow-hidden shadow-md border border-indigo-50">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-indigo-600 text-white text-xs font-bold uppercase tracking-wider">
                    <tr>
                        <th class="p-4">Cliente</th>
                        <th class="p-4">Cidade</th>
                        <th class="p-4">Endereco</th>
                        <th class="p-4">CNPJ</th>
                        <th class="p-4">Ultimo Servico</th>
                        <th class="p-4 text-right">Acoes</th>
                    </tr>
                </thead>
                <tbody id="tbody-clientes" class="divide-y divide-indigo-50 text-sm"></tbody>
            </table>
        </div>
        <div class="p-4 border-t border-indigo-50 bg-indigo-50/30 text-center text-sm text-indigo-400" id="cliente-loading">Carregando...</div>
    </div>
</section>

<!-- VIEW: GERADOR -->
<section id="view-gerador" class="hidden">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cliente Selecionado -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg border border-indigo-100 p-6 shadow-md relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10">
                    <i data-lucide="user" class="w-24 h-24 text-indigo-600"></i>
                </div>
                <h2 class="text-lg font-bold mb-4 text-indigo-900">Cliente Selecionado</h2>
                <div id="box-cliente-info">
                    <div class="p-3 bg-yellow-50 text-yellow-800 rounded-md border border-yellow-200 text-sm">
                        <i data-lucide="alert-circle" class="inline w-4 h-4 mr-1"></i> Nenhum cliente selecionado
                    </div>
                    <button onclick="navigate('dashboard')" class="w-full mt-3 px-4 py-2 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300">Voltar e selecionar</button>
                </div>
                <input type="hidden" id="ctx-id">
                <input type="hidden" id="ctx-nome">
                <input type="hidden" id="ctx-razao">
                <input type="hidden" id="ctx-cnpj">
                <input type="hidden" id="ctx-cnae">
                <input type="hidden" id="ctx-endereco">
                <input type="hidden" id="ctx-rua">
                <input type="hidden" id="ctx-numero">
                <input type="hidden" id="ctx-bairro">
                <input type="hidden" id="ctx-cidade">
                <input type="hidden" id="ctx-uf">
            </div>
        </div>

        <!-- Formularios -->
        <div class="lg:col-span-2 bg-white rounded-lg shadow-md overflow-hidden border border-indigo-50">
            <div class="flex border-b border-indigo-50 bg-indigo-50/30">
                <div onclick="setDocTab('laudo')" class="flex-1 p-4 text-center cursor-pointer border-b-2 border-indigo-600 bg-white font-bold text-indigo-600" id="tab-laudo">Laudo</div>
                <div onclick="setDocTab('recibo')" class="flex-1 p-4 text-center cursor-pointer border-b-2 border-transparent hover:bg-indigo-50 text-indigo-400" id="tab-recibo">Recibo</div>
                <div onclick="setDocTab('orcamento')" class="flex-1 p-4 text-center cursor-pointer border-b-2 border-transparent hover:bg-indigo-50 text-indigo-400" id="tab-orcamento">Orcamento</div>
            </div>

            <div class="p-6">
                <!-- FORM LAUDO -->
                <form id="form-laudo" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">Data do Servico</label>
                            <input type="date" id="laudo-data" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Tipo de Laudo</label>
                            <select id="laudo-tipo" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                <option value="padrao">Padrao</option>
                                <option value="caixa">Caixa D'agua</option>
                                <option value="dedetizacao">Dedetizacao</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Garantia</label>
                        <select id="laudo-garantia" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <option value="03 Meses">03 Meses</option>
                            <option value="06 Meses" selected>06 Meses</option>
                            <option value="12 Meses">12 Meses</option>
                        </select>
                    </div>
                    <div class="p-4 border border-indigo-100 rounded-lg bg-indigo-50/30">
                        <label class="block text-sm font-bold mb-3 text-indigo-700">Pragas Controladas</label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="barata"> Barata</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="rato"> Rato</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="camundongo"> Camundongo</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="cupim"> Cupim</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="pulga"> Pulga</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="escorpiao"> Escorpiao</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="mosca"> Mosca</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="formiga"> Formiga</label>
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="outros"> Outros</label>
                        </div>
                    </div>
                    <button type="submit" class="w-full px-4 py-3 bg-indigo-600 text-white rounded-lg shadow-md hover:bg-indigo-700 transition font-medium">Gerar e Baixar Laudo</button>
                </form>

                <!-- FORM RECIBO -->
                <form id="form-recibo" class="space-y-5 hidden">
                    <div class="grid grid-cols-2 gap-4">
                        <div><label class="block text-sm font-medium mb-1">Data</label><input type="date" id="recibo-data" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" required></div>
                        <div><label class="block text-sm font-medium mb-1">Garantia</label>
                            <select id="recibo-garantia" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                <option value="03 Meses">03 Meses</option>
                                <option value="06 Meses" selected>06 Meses</option>
                                <option value="12 Meses">12 Meses</option>
                            </select>
                        </div>
                    </div>

                    <!-- Tabela de Serviços -->
                    <div class="border border-indigo-200 rounded-lg overflow-hidden">
                        <div class="bg-indigo-50 p-3 border-b border-indigo-200">
                            <h4 class="font-bold text-indigo-900 text-sm">Serviços Prestados</h4>
                        </div>
                        <div class="p-4 space-y-3">
                            <!-- Linha 0 -->
                            <div class="grid grid-cols-12 gap-2 items-center">
                                <div class="col-span-2">
                                    <label class="block text-xs font-medium mb-1">Quant.</label>
                                    <input type="number" id="recibo-quant" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0" min="0">
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-medium mb-1">Serviço</label>
                                    <input type="text" id="recibo-servico" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="Descrição">
                                </div>
                                <div class="col-span-2">
                                    <label class="block text-xs font-medium mb-1">Valor Un.</label>
                                    <input type="number" id="recibo-valor" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0.00" step="0.01" min="0">
                                </div>
                                <div class="col-span-3">
                                    <label class="block text-xs font-medium mb-1">Total</label>
                                    <input type="text" id="recibo-valortotal" class="w-full px-2 py-1 border border-slate-200 rounded text-sm bg-slate-50" readonly placeholder="0,00">
                                </div>
                            </div>

                            <!-- Linha 1 -->
                            <div class="grid grid-cols-12 gap-2 items-center">
                                <div class="col-span-2">
                                    <input type="number" id="recibo-quant1" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0" min="0">
                                </div>
                                <div class="col-span-5">
                                    <input type="text" id="recibo-servico1" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="Descrição">
                                </div>
                                <div class="col-span-2">
                                    <input type="number" id="recibo-valor1" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0.00" step="0.01" min="0">
                                </div>
                                <div class="col-span-3">
                                    <input type="text" id="recibo-valortotal1" class="w-full px-2 py-1 border border-slate-200 rounded text-sm bg-slate-50" readonly placeholder="0,00">
                                </div>
                            </div>

                            <!-- Linha 2 -->
                            <div class="grid grid-cols-12 gap-2 items-center">
                                <div class="col-span-2">
                                    <input type="number" id="recibo-quant2" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0" min="0">
                                </div>
                                <div class="col-span-5">
                                    <input type="text" id="recibo-servico3" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="Descrição">
                                </div>
                                <div class="col-span-2">
                                    <input type="number" id="recibo-valor2" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0.00" step="0.01" min="0">
                                </div>
                                <div class="col-span-3">
                                    <input type="text" id="recibo-valortotal2" class="w-full px-2 py-1 border border-slate-200 rounded text-sm bg-slate-50" readonly placeholder="0,00">
                                </div>
                            </div>

                            <!-- Linha 3 -->
                            <div class="grid grid-cols-12 gap-2 items-center">
                                <div class="col-span-2">
                                    <input type="number" id="recibo-quant3" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0" min="0">
                                </div>
                                <div class="col-span-5">
                                    <input type="text" id="recibo-servico4" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="Descrição">
                                </div>
                                <div class="col-span-2">
                                    <input type="number" id="recibo-valor3" class="w-full px-2 py-1 border border-indigo-200 rounded text-sm" placeholder="0.00" step="0.01" min="0">
                                </div>
                                <div class="col-span-3">
                                    <input type="text" id="recibo-valortotal3" class="w-full px-2 py-1 border border-slate-200 rounded text-sm bg-slate-50" readonly placeholder="0,00">
                                </div>
                            </div>

                            <!-- Total Geral -->
                            <div class="pt-3 border-t border-indigo-200">
                                <div class="flex justify-end items-center gap-4">
                                    <span class="font-bold text-indigo-900">TOTAL GERAL:</span>
                                    <input type="text" id="recibo-valorsomatotal" class="w-32 px-3 py-2 border border-indigo-300 rounded-lg bg-indigo-50 font-bold text-indigo-900" readonly placeholder="0,00">
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full px-4 py-3 bg-indigo-600 text-white rounded-lg shadow-md hover:bg-indigo-700 transition font-medium">Gerar e Baixar Recibo</button>
                </form>

                <!-- FORM ORCAMENTO -->
                <form id="form-orcamento" class="space-y-5 hidden">
                    <div>
                        <label class="block text-sm font-medium mb-1">Procedimento</label>
                        <input id="orc-procedimento" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Ex: Dedetização, Desratização, etc.">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Descrição do Serviço</label>
                        <textarea id="orc-descricao" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" rows="3" placeholder="Descreva as dependências e detalhes do serviço..."></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">Preço (R$)</label>
                            <input type="number" id="orc-preco" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="300.00" step="0.01" min="0">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Preço por Extenso</label>
                            <input id="orc-preco-extenso" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="trezentos reais">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div><label class="block text-sm font-medium mb-1">Validade</label><input id="orc-validade" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" value="30 dias"></div>
                        <div><label class="block text-sm font-medium mb-1">Data</label><input type="date" id="orc-data" class="w-full px-3 py-2 border border-indigo-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"></div>
                    </div>
                    <button type="submit" class="w-full px-4 py-3 bg-indigo-600 text-white rounded-lg shadow-md hover:bg-indigo-700 transition font-medium">Gerar e Baixar Orcamento</button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- VIEW: ARQUIVOS & DOCUMENTOS -->
<section id="view-arquivos" class="hidden">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-indigo-950">Arquivos & Documentos</h1>
        <p class="text-sm text-indigo-500">Gerencie todos os arquivos, documentos gerados e notas fiscais</p>
    </div>

    <!-- Tabs Principais -->
    <div class="bg-white rounded-lg border border-indigo-100 mb-6 shadow-sm overflow-hidden">
        <div class="flex border-b border-indigo-100">
            <button onclick="setArqTab('arquivos')" id="tab-arq-arquivos" class="px-6 py-4 border-b-2 border-indigo-600 bg-white font-bold text-indigo-600">
                <i data-lucide="folder" class="w-4 h-4 inline mr-2"></i> Arquivos
            </button>
            <button onclick="setArqTab('historico')" id="tab-arq-historico" class="px-6 py-4 border-b-2 border-transparent hover:bg-indigo-50 text-slate-600">
                <i data-lucide="file-text" class="w-4 h-4 inline mr-2"></i> Histórico
            </button>
            <button onclick="setArqTab('notas')" id="tab-arq-notas" class="px-6 py-4 border-b-2 border-transparent hover:bg-indigo-50 text-slate-600">
                <i data-lucide="receipt" class="w-4 h-4 inline mr-2"></i> Notas Fiscais
            </button>
            <button onclick="setArqTab('boletos')" id="tab-arq-boletos" class="px-6 py-4 border-b-2 border-transparent hover:bg-indigo-50 text-slate-600">
                <i data-lucide="credit-card" class="w-4 h-4 inline mr-2"></i> Boletos
            </button>
        </div>
    </div>

    <!-- TAB: ARQUIVOS -->
    <div id="arq-tab-arquivos">
        <!-- Abas de Categorias -->
        <div class="bg-white rounded-lg border border-indigo-100 mb-6 shadow-sm overflow-hidden">
            <div class="flex border-b border-indigo-50">
                <button onclick="setArqCategoria('todos')" id="cat-todos" class="flex-1 p-4 text-center border-b-2 border-indigo-600 bg-white font-bold text-indigo-600">Todos</button>
                <button onclick="setArqCategoria('laudo')" id="cat-laudo" class="flex-1 p-4 text-center border-b-2 border-transparent hover:bg-indigo-50 text-indigo-400">Laudos</button>
                <button onclick="setArqCategoria('recibo')" id="cat-recibo" class="flex-1 p-4 text-center border-b-2 border-transparent hover:bg-indigo-50 text-indigo-400">Recibos</button>
                <button onclick="setArqCategoria('orcamento')" id="cat-orcamento" class="flex-1 p-4 text-center border-b-2 border-transparent hover:bg-indigo-50 text-indigo-400">Orçamentos</button>
                <button onclick="setArqCategoria('upload')" id="cat-upload" class="flex-1 p-4 text-center border-b-2 border-transparent hover:bg-indigo-50 text-indigo-400">Uploads</button>
            </div>
        </div>

    <!-- Filtros e Buscas -->
    <div class="bg-white rounded-lg border border-indigo-100 p-4 mb-6 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
