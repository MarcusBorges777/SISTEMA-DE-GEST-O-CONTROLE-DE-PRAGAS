        const notas = await res.json();

        const tbody = document.getElementById('tbody-valores-notas');
        if(!notas || notas.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400">Nenhuma nota fiscal encontrada</td></tr>';
            return;
        }

        tbody.innerHTML = notas.map(n => {
            const valorTotal = parseFloat(n.valor_total || 0);

            // Calcular tributos somando todos os impostos individuais
            const iss = parseFloat(n.iss || 0);
            const pis = parseFloat(n.pis || 0);
            const cofins = parseFloat(n.cofins || 0);
            const inss = parseFloat(n.inss || 0);
            const ir = parseFloat(n.ir || 0);
            const csll = parseFloat(n.csll || 0);
            const outras = parseFloat(n.outras_retencoes || 0);
            const tributos = iss + pis + cofins + inss + ir + csll + outras;

            const valorLiquido = valorTotal - tributos;

            return `
                <tr class="hover:bg-indigo-50/30">
                    <td class="p-3 font-medium">${n.numero_nota || 'S/N'}</td>
                    <td class="p-3">${n.cliente_nome || '-'}</td>
                    <td class="p-3 text-xs">${new Date(n.data_emissao).toLocaleDateString('pt-BR')}</td>
                    <td class="p-3 font-bold text-green-600">R$ ${valorTotal.toFixed(2).replace('.', ',')}</td>
                    <td class="p-3 font-bold text-red-600">R$ ${tributos.toFixed(2).replace('.', ',')}</td>
                    <td class="p-3 font-bold text-blue-600">R$ ${valorLiquido.toFixed(2).replace('.', ',')}</td>
                    <td class="p-3 text-right">
                        <button onclick="abrirModalTributos(${n.id})" class="p-2 bg-indigo-500 hover:bg-indigo-600 text-white rounded-lg transition" title="Gerenciar Tributos">
                            <i data-lucide="calculator" class="w-4 h-4"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');

        initIcons();
    } catch(e) {
        showToast('Erro ao carregar notas fiscais', 'error');
        console.error(e);
    }
}

