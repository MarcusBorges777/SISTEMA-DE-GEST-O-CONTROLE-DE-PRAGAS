// Calcular KPIs Inteligentes
function calcularKPIs(valores) {
    if (valores.length === 0) return;

    const totalDocs = (parseInt(document.getElementById('stat-laudos')?.textContent || 0) +
                      parseInt(document.getElementById('stat-recibos')?.textContent || 0) +
                      parseInt(document.getElementById('stat-orcamentos')?.textContent || 0) +
                      parseInt(document.getElementById('stat-notas')?.textContent || 0));

    const faturamentoTotal = valores.reduce((a, b) => a + b, 0);
    const ticketMedio = totalDocs > 0 ? faturamentoTotal / totalDocs : 0;

    // Crescimento (último mês vs penúltimo)
    const crescimento = valores.length >= 2 ?
        ((valores[valores.length - 1] - valores[valores.length - 2]) / valores[valores.length - 2] * 100) : 0;

    // Média diária (assumindo 30 dias no período)
    const mediaDiaria = totalDocs / 30;

    // Atualizar KPIs
    document.getElementById('kpi-ticket-medio').textContent = 'R$ ' + formatarValor(ticketMedio);
    document.getElementById('kpi-crescimento').textContent = (crescimento >= 0 ? '+' : '') + crescimento.toFixed(1) + '%';
    document.getElementById('kpi-media-diaria').textContent = mediaDiaria.toFixed(1);

    const variacaoEl = document.getElementById('kpi-ticket-variacao');
    if (variacaoEl) {
        const variacaoPerc = Math.floor(Math.random() * 30) - 10; // Exemplo
        variacaoEl.textContent = (variacaoPerc >= 0 ? '+' : '') + variacaoPerc + '%';
        variacaoEl.style.backgroundColor = variacaoPerc >= 0 ? 'rgba(16, 185, 129, 0.3)' : 'rgba(239, 68, 68, 0.3)';
    }
}

