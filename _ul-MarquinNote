async function fetchBoletos() {
    try {
        const res = await fetch('/api/boletos');
        const boletos = await res.json();

        const tbody = document.getElementById('tbody-boletos');
        if(!boletos || boletos.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-slate-400">Nenhum boleto cadastrado</td></tr>';
            return;
        }

        tbody.innerHTML = boletos.map(b => {
            const hoje = new Date();
            const venc = new Date(b.data_vencimento);
            const diasRestantes = Math.ceil((venc - hoje) / (1000 * 60 * 60 * 24));

            let statusClass = 'bg-gray-100 text-gray-700';
            let statusText = b.status;

            if(b.status === 'pago') {
                statusClass = 'bg-green-100 text-green-700';
                statusText = 'Pago';
            } else if(b.status === 'cancelado') {
                statusClass = 'bg-red-100 text-red-700';
                statusText = 'Cancelado';
            } else if(diasRestantes < 0) {
                statusClass = 'bg-red-100 text-red-700';
                statusText = 'Vencido';
            } else if(diasRestantes <= 3) {
                statusClass = 'bg-orange-100 text-orange-700';
                statusText = 'Urgente';
            } else {
                statusClass = 'bg-blue-100 text-blue-700';
                statusText = 'Pendente';
            }

            const dataVenc = new Date(b.data_vencimento).toLocaleDateString('pt-BR');
            const valor = parseFloat(b.valor).toFixed(2).replace('.', ',');

            return `
                <tr class="hover:bg-indigo-50/30">
                    <td class="p-4 font-medium text-slate-700">${b.cliente_nome}</td>
                    <td class="p-4 text-slate-600">${b.descricao || '-'}</td>
                    <td class="p-4 font-bold text-green-600">R$ ${valor}</td>
                    <td class="p-4 text-slate-600 text-xs">${dataVenc}</td>
                    <td class="p-4">
                        <span class="px-2 py-1 ${statusClass} rounded text-xs font-bold">${statusText}</span>
                    </td>
                    <td class="p-4 text-right space-x-2">
                        ${b.status === 'pendente' ? `
                            <button onclick='pagarBoleto(${b.id})' class="inline-flex items-center p-2 bg-green-500 hover:bg-green-600 text-white rounded-lg shadow transition" title="Marcar como Pago">
                                <i data-lucide="check" class="w-4 h-4"></i>
                            </button>
                        ` : ''}
                        <button onclick='editarBoleto(${b.id})' class="inline-flex items-center p-2 bg-indigo-500 hover:bg-indigo-600 text-white rounded-lg shadow transition" title="Editar">
                            <i data-lucide="edit" class="w-4 h-4"></i>
                        </button>
                        <button onclick='excluirBoleto(${b.id})' class="inline-flex items-center p-2 bg-rose-500 hover:bg-rose-600 text-white rounded-lg shadow transition" title="Excluir">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');

        initIcons();

        // Carregar avisos
        carregarAvisosBoletos();
    } catch(e) {
        showToast('Erro ao carregar boletos', 'error');
        console.error(e);
    }
}

