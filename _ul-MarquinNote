let arquivoTagsAtual = {caminho: '', nome: ''};

async function gerenciarTagsArquivo(caminho, nome) {
    arquivoTagsAtual = {caminho, nome};

    document.getElementById('tags-arquivo-nome').textContent = nome;

    try {
        // Carregar todas as tags disponíveis
        const resTags = await fetch('/api/tags');
        const todasTags = await resTags.json();

        // Carregar tags do arquivo atual
        const resArquivoTags = await fetch(`/api/arquivo/tags?caminho=${encodeURIComponent(caminho)}`);
        const tagsDoArquivo = await resArquivoTags.json();

        const tagsIds = tagsDoArquivo.map(t => t.id);

        // Renderizar lista de tags
        const container = document.getElementById('tags-disponiveis-container');
        container.innerHTML = '';

        if(todasTags.length === 0) {
            container.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">Nenhuma tag cadastrada. Crie uma nova tag abaixo.</p>';
        } else {
            todasTags.forEach(tag => {
                const tagChecked = tagsIds.includes(tag.id);
                const div = document.createElement('div');
                div.className = 'flex items-center gap-3 p-3 border border-slate-200 rounded-lg hover:bg-slate-50 transition';
                div.innerHTML = `
                    <input type="checkbox"
                           id="tag-check-${tag.id}"
                           ${tagChecked ? 'checked' : ''}
                           onchange="toggleTagArquivo(${tag.id}, '${tag.nome}')"
                           class="w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500">
                    <label for="tag-check-${tag.id}" class="flex-1 flex items-center gap-2 cursor-pointer">
                        <span class="w-3 h-3 rounded-full" style="background-color: ${tag.cor}"></span>
                        <span class="font-medium text-slate-700">${tag.nome}</span>
                    </label>
                `;
                container.appendChild(div);
            });
        }

        openModalTagsArquivo();
    } catch(e) {
        showToast('Erro ao carregar tags', 'error');
        console.error(e);
    }
}

async function toggleTagArquivo(tagId, tagNome) {
    const checkbox = document.getElementById(`tag-check-${tagId}`);
    const isChecked = checkbox.checked;

    try {
        if(isChecked) {
            // Adicionar tag
            const res = await fetch('/api/arquivo/tag/adicionar', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    caminho: arquivoTagsAtual.caminho,
                    tag_id: tagId
                })
            });

            if(res.ok) {
                showToast(`Tag "${tagNome}" adicionada!`, 'success');
            } else {
                checkbox.checked = false;
                showToast('Erro ao adicionar tag', 'error');
            }
        } else {
            // Remover tag
            const res = await fetch('/api/arquivo/tag/remover', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    caminho: arquivoTagsAtual.caminho,
                    tag_id: tagId
                })
            });

            if(res.ok) {
                showToast(`Tag "${tagNome}" removida!`, 'success');
            } else {
                checkbox.checked = true;
                showToast('Erro ao remover tag', 'error');
            }
        }
    } catch(e) {
        checkbox.checked = !isChecked;
        showToast('Erro ao atualizar tag', 'error');
        console.error(e);
    }
}

async function criarNovaTagRapida() {
    const nome = prompt('Nome da nova tag:');
    if(!nome || !nome.trim()) return;

    const cores = ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899', '#06B6D4'];
    const cor = cores[Math.floor(Math.random() * cores.length)];

    try {
        const res = await fetch('/api/tags', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                nome: nome.trim(),
                descricao: '',
                cor: cor
            })
        });

        if(res.ok) {
            showToast('Tag criada com sucesso!', 'success');
            // Recarregar modal de tags
            gerenciarTagsArquivo(arquivoTagsAtual.caminho, arquivoTagsAtual.nome);
        } else {
            showToast('Erro ao criar tag', 'error');
        }
    } catch(e) {
        showToast('Erro ao criar tag', 'error');
        console.error(e);
    }
}

