async function gerarAnaliseCompleta() {
    const btnGerar = document.getElementById('btn-gerar-insights');
    const loading = document.getElementById('insights-loading');
    const resultado = document.getElementById('insights-resultado');

    // Mostrar loading
    btnGerar.disabled = true;
    btnGerar.innerHTML = '<i data-lucide="loader" class="w-5 h-5 inline mr-2 animate-spin"></i>Analisando...';
    loading.classList.remove('hidden');
    resultado.classList.add('hidden');
    initIcons();

    try {
        const response = await fetch('/api/ia-analise-completa');
        const dados = await response.json();

        loading.classList.add('hidden');

        if(dados.sucesso) {
            // Mostrar dados brutos
            const brutos = dados.dados_brutos;

            document.getElementById('insight-faturamento-total').textContent =
                'R$ ' + formatarValor(brutos.faturamento_total);
            document.getElementById('insight-total-notas').textContent =
                brutos.total_notas + ' (' + formatarValor(brutos.valor_notas) + ')';
            document.getElementById('insight-total-recibos').textContent =
                brutos.total_recibos + ' (' + formatarValor(brutos.valor_recibos) + ')';
            document.getElementById('insight-total-orcamentos').textContent =
                brutos.total_orcamentos;

            // Mostrar análise da IA
            const conteudo = document.getElementById('insights-conteudo');
            conteudo.innerHTML = formatarTextoIA(dados.analise_ia);

            resultado.classList.remove('hidden');
            initIcons();

            // Scroll suave até o resultado
            resultado.scrollIntoView({ behavior: 'smooth', block: 'start' });

            showToast('✅ Análise completa gerada com sucesso!', 'success');
        } else {
            showToast('❌ ' + (dados.erro || 'Erro ao gerar análise'), 'error');

            // Se tiver dados brutos mesmo com erro, mostrar
            if(dados.dados_brutos) {
                const brutos = dados.dados_brutos;
                document.getElementById('insight-faturamento-total').textContent =
                    'R$ ' + formatarValor(brutos.faturamento_total);
                document.getElementById('insight-total-notas').textContent = brutos.total_notas;
                document.getElementById('insight-total-recibos').textContent = brutos.total_recibos;
                document.getElementById('insights-conteudo').innerHTML =
                    '<p class="text-red-600"><strong>Erro:</strong> ' + dados.erro + '</p>' +
                    '<pre class="mt-4 text-xs bg-gray-100 p-4 rounded">' + dados.relatorio + '</pre>';
                resultado.classList.remove('hidden');
            }
        }

    } catch(error) {
        loading.classList.add('hidden');
        showToast('❌ Erro ao conectar com servidor', 'error');
        console.error('Erro:', error);
    } finally {
        btnGerar.disabled = false;
        btnGerar.innerHTML = '<i data-lucide="sparkles" class="w-5 h-5 inline mr-2"></i>Gerar Análise Completa';
        initIcons();
    }
}

function formatarTextoIA(texto) {
    // Formatar markdown básico
    let html = texto;

    // Títulos com **
    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-purple-900">$1</strong>');

    // Listas com -
    html = html.replace(/^- (.+)$/gm, '• $1');

    // Quebras de linha
    html = html.replace(/\n/g, '<br>');

    // Números grandes (R$ formatados)
    html = html.replace(/R\$ ([\d,.]+)/g, '<span class="text-green-600 font-bold">R$ $1</span>');

    return html;
}

