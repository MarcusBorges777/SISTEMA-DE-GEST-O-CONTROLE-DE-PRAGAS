// Funções para calcular totais do recibo automaticamente
function calcularTotalRecibo(linha) {
    const quant = parseFloat(document.getElementById(`recibo-quant${linha ? linha : ''}`).value || 0);
    const valor = parseFloat(document.getElementById(`recibo-valor${linha ? linha : ''}`).value || 0);
    const total = quant * valor;
    document.getElementById(`recibo-valortotal${linha ? linha : ''}`).value = total.toFixed(2).replace('.', ',');
    calcularSomaTotal();
}

function calcularSomaTotal() {
    const total0 = parseFloat(document.getElementById('recibo-valortotal').value.replace(',', '.') || 0);
    const total1 = parseFloat(document.getElementById('recibo-valortotal1').value.replace(',', '.') || 0);
    const total2 = parseFloat(document.getElementById('recibo-valortotal2').value.replace(',', '.') || 0);
    const total3 = parseFloat(document.getElementById('recibo-valortotal3').value.replace(',', '.') || 0);
    const somaTotal = total0 + total1 + total2 + total3;
    document.getElementById('recibo-valorsomatotal').value = somaTotal.toFixed(2).replace('.', ',');
}

