// Consultar Receita Federal
async function consultarRF() {
    const cnpj = document.getElementById('rf-cnpj').value.replace(/\D/g, '');
    const nome = document.getElementById('rf-nome').value.trim();

    if(!cnpj && !nome) {
        showToast('Digite um CNPJ ou Nome para buscar', 'error');
        return;
    }

    if(cnpj && cnpj.length < 8) {
        showToast('CNPJ deve ter pelo menos 8 digitos', 'error');
        return;
    }

    showToast('Consultando Receita Federal...', 'info');

    try {
        let url = '/api/empresas?';
        if(cnpj) url += `cnpj=${cnpj}`;
        if(nome) url += (cnpj ? '&' : '') + `nome=${encodeURIComponent(nome)}`;

        const res = await fetch(url);
        const empresas = await res.json();

        if(empresas.length > 0) {
            renderRFResults(empresas);
            openModalRF();
        } else {
            showToast('Nenhuma empresa encontrada', 'error');
        }
    } catch(e) {
        showToast('Erro ao consultar RF', 'error');
    }
}

