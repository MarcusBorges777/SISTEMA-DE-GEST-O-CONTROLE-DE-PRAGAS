function renderArquivos(arquivos) {
    const tbody = document.getElementById('tbody-arquivos');
    const busca = document.getElementById('arq-busca').value.toLowerCase();
    const tipo = document.getElementById('arq-tipo').value;

    // Filtrar arquivos
    let filtrados = arquivos;

    // Filtrar por categoria
    if(categoriaAtual !== 'todos') {
        if(categoriaAtual === 'upload') {
            // Uploads são arquivos que não começam com LAUDO, RECIBO ou ORCAMENTO
            filtrados = filtrados.filter(a => {
                const nome = a.nome.toUpperCase();
                return !nome.startsWith('LAUDO') && !nome.startsWith('RECIBO') && !nome.startsWith('ORCAMENTO') && !nome.startsWith('ORÇAMENTO');
            });
        } else {
            const catUpper = categoriaAtual.toUpperCase();
            filtrados = filtrados.filter(a => {
                const nome = a.nome.toUpperCase();
                return nome.startsWith(catUpper) || (catUpper === 'ORCAMENTO' && nome.startsWith('ORÇAMENTO'));
            });
        }
    }

    // Filtrar por busca
    if(busca) {
        filtrados = filtrados.filter(a => a.nome.toLowerCase().includes(busca));
    }

    // Filtrar por tipo/extensão
    if(tipo) {
        filtrados = filtrados.filter(a => a.extensao === tipo);
    }

    tbody.innerHTML = '';
    if(filtrados.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-slate-500">Nenhum arquivo encontrado</td></tr>';
        return;
    }

    filtrados.forEach(arq => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-indigo-50/30 transition';

        // Ícone baseado na extensão
        let icone = 'file';
        if(arq.extensao === '.docx') icone = 'file-text';
        else if(arq.extensao === '.pdf') icone = 'file-text';
        else if(arq.extensao === '.xlsx') icone = 'file-spreadsheet';
        else if(['.jpg', '.png'].includes(arq.extensao)) icone = 'image';

        const tamanhoKB = (arq.tamanho / 1024).toFixed(2);
        const data = new Date(arq.data_modificacao).toLocaleString('pt-BR');

        tr.innerHTML = `
            <td class="p-4">
                <div class="flex items-center gap-2">
                    <i data-lucide="${icone}" class="w-5 h-5 text-indigo-500"></i>
                    <span class="font-medium text-slate-700">${arq.nome}</span>
                </div>
            </td>
            <td class="p-4 text-slate-600">${tamanhoKB} KB</td>
            <td class="p-4 text-slate-600 text-xs">${data}</td>
            <td class="p-4 text-right space-x-2">
                <button onclick='gerenciarTagsArquivo("${arq.caminho.replace(/\\/g, '\\\\')}", "${arq.nome}")' class="inline-flex items-center p-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg shadow transition" title="Gerenciar Tags">
                    <i data-lucide="tag" class="w-4 h-4"></i>
