// Aplicar períodos rápidos
function aplicarPeriodoRapido(periodo) {
    const hoje = new Date();
    const dataFim = hoje.toISOString().split('T')[0];
    let dataInicio;

    switch(periodo) {
        case 'hoje':
            dataInicio = dataFim;
            break;
        case 'semana':
            const semanaAtras = new Date(hoje);
            semanaAtras.setDate(hoje.getDate() - 7);
            dataInicio = semanaAtras.toISOString().split('T')[0];
            break;
        case 'mes':
            const mesAtras = new Date(hoje);
            mesAtras.setMonth(hoje.getMonth() - 1);
            dataInicio = mesAtras.toISOString().split('T')[0];
            break;
        case 'trimestre':
            const trimestreAtras = new Date(hoje);
            trimestreAtras.setMonth(hoje.getMonth() - 3);
            dataInicio = trimestreAtras.toISOString().split('T')[0];
            break;
        case 'semestre':
            const semestreAtras = new Date(hoje);
            semestreAtras.setMonth(hoje.getMonth() - 6);
            dataInicio = semestreAtras.toISOString().split('T')[0];
            break;
        case 'ano':
            const anoAtras = new Date(hoje);
            anoAtras.setFullYear(hoje.getFullYear() - 1);
            dataInicio = anoAtras.toISOString().split('T')[0];
            break;
        case 'tudo':
            dataInicio = '';
            document.getElementById('analise-data-inicio').value = '';
            document.getElementById('analise-data-fim').value = '';
            fetchAnalise();
            return;
    }

    document.getElementById('analise-data-inicio').value = dataInicio;
    document.getElementById('analise-data-fim').value = dataFim;
    fetchAnalise();
}

