function renderDocumentos(docs) {
    const tbody = document.getElementById('tbody-docs');
    const filtroTipo = document.getElementById('hist-filter-tipo').value;

    // Filtrar por tipo se selecionado
    const docsFiltrados = filtroTipo ? docs.filter(d => d.tipo_doc === filtroTipo) : docs;

    tbody.innerHTML = '';
    if(docsFiltrados.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-slate-500">Nenhum documento encontrado</td></tr>';
        return;
    }

    docsFiltrados.forEach(d => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-indigo-50/30';

        // Cor do badge baseado no tipo
        let badgeColor = 'bg-indigo-100 text-indigo-700';
        if(d.tipo_doc === 'UPLOAD') badgeColor = 'bg-purple-100 text-purple-700';
        else if(d.tipo_doc === 'RECIBO') badgeColor = 'bg-green-100 text-green-700';
        else if(d.tipo_doc === 'ORCAMENTO') badgeColor = 'bg-blue-100 text-blue-700';

        // Formatar valor
        const valorTotal = d.valor_total || 0;
        const valorFormatado = valorTotal > 0
            ? `R$ ${valorTotal.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.')}`
            : '-';

        // Informações do cliente
        const cliente = d.cliente_nome || 'Não informado';
        const cnpj = d.cliente_cnpj || '-';

        tr.innerHTML = `
            <td class="p-4"><span class="px-2 py-1 ${badgeColor} rounded text-xs font-bold">${d.tipo_doc}</span></td>
            <td class="p-4 font-medium text-slate-700">${cliente}</td>
            <td class="p-4 text-xs text-slate-600 font-mono">${cnpj}</td>
            <td class="p-4 text-right font-bold ${valorTotal > 0 ? 'text-green-600' : 'text-slate-400'}">${valorFormatado}</td>
            <td class="p-4 text-xs text-slate-600">${new Date(d.data_geracao).toLocaleString('pt-BR')}</td>
            <td class="p-4 text-right space-x-2">
                <button onclick='visualizarDocumento("${d.nome_arquivo}")' class="inline-flex items-center p-2 bg-purple-500 hover:bg-purple-600 text-white rounded-lg shadow transition" title="Visualizar">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                </button>
                <button onclick='baixarDocumento("${d.nome_arquivo}")' class="inline-flex items-center p-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg shadow transition" title="Baixar">
