// Processar PDFs
async function processarPDFs(files) {
    const progressDiv = document.getElementById('pdf-upload-progress');
    const progressBar = document.getElementById('pdf-progress-bar');
    const progressText = document.getElementById('pdf-progress-text');
    const progressPercent = document.getElementById('pdf-progress-percent');
    const progressStatus = document.getElementById('pdf-progress-status');

    progressDiv.classList.remove('hidden');

    let sucessos = 0;
    let erros = 0;
    const total = files.length;

    for(let i = 0; i < files.length; i++) {
        const file = files[i];
        const porcentagem = Math.round(((i + 1) / total) * 100);

        progressText.textContent = `Processando ${i + 1} de ${total}`;
        progressPercent.textContent = `${porcentagem}%`;
        progressBar.style.width = `${porcentagem}%`;
        progressStatus.textContent = file.name;

        const formData = new FormData();
        formData.append('arquivos', file);

        try {
            const response = await fetch('/api/upload-pdf', {
                method: 'POST',
                body: formData
            });

            if(response.ok) {
                const resultado = await response.json();
                sucessos += resultado.sucessos || 0;
                erros += resultado.erros || 0;
            } else {
                erros++;
            }
        } catch(error) {
            erros++;
            console.error('Erro:', error);
        }

        await new Promise(resolve => setTimeout(resolve, 100));
    }

    progressText.textContent = 'Concluído!';
    progressPercent.textContent = '100%';
    progressBar.style.width = '100%';
    progressStatus.textContent = `${sucessos} sucesso(s), ${erros} erro(s)`;

    if(sucessos > 0) {
        showToast(`✅ ${sucessos} PDF(s) processado(s)!`, 'success');
        fetchPDFsProcessados();
        fetchAnalise();
    }

    if(erros > 0) {
        showToast(`⚠️ ${erros} erro(s)`, 'error');
    }

    setTimeout(() => {
        progressDiv.classList.add('hidden');
        progressBar.style.width = '0%';
    }, 3000);
}

