// ==================== MODAL TRIBUTOS ====================

async function abrirModalTributos(notaId) {
    try {
        const res = await fetch(`/api/notas-fiscais/${notaId}/tributos`);
        const data = await res.json();

        document.getElementById('tributos-nota-id').value = data.id;
        document.getElementById('modal-tributos-subtitle').textContent = `NF #${data.numero_nota} - R$ ${data.valor_total.toFixed(2)}`;
        document.getElementById('tributos-valor-total').textContent = `R$ ${data.valor_total.toFixed(2).replace('.', ',')}`;

        document.getElementById('tributos-iss').value = data.tributos.iss || 0;
        document.getElementById('tributos-pis').value = data.tributos.pis || 0;
        document.getElementById('tributos-cofins').value = data.tributos.cofins || 0;
        document.getElementById('tributos-inss').value = data.tributos.inss || 0;
        document.getElementById('tributos-ir').value = data.tributos.ir || 0;
        document.getElementById('tributos-csll').value = data.tributos.csll || 0;
        document.getElementById('tributos-outras').value = data.tributos.outras_retencoes || 0;

        calcularTributos();

        document.getElementById('modal-tributos').classList.remove('hidden');
        document.getElementById('modal-tributos').classList.add('flex');
        initIcons();
    } catch(e) {
        showToast('Erro ao carregar tributos', 'error');
        console.error(e);
    }
}

function closeModalTributos() {
    document.getElementById('modal-tributos').classList.add('hidden');
    document.getElementById('modal-tributos').classList.remove('flex');
}

function calcularTributos() {
    const valorTotal = parseFloat(document.getElementById('tributos-valor-total').textContent.replace('R$ ', '').replace(',', '.')) || 0;

    const iss = parseFloat(document.getElementById('tributos-iss').value) || 0;
    const pis = parseFloat(document.getElementById('tributos-pis').value) || 0;
    const cofins = parseFloat(document.getElementById('tributos-cofins').value) || 0;
    const inss = parseFloat(document.getElementById('tributos-inss').value) || 0;
    const ir = parseFloat(document.getElementById('tributos-ir').value) || 0;
    const csll = parseFloat(document.getElementById('tributos-csll').value) || 0;
    const outras = parseFloat(document.getElementById('tributos-outras').value) || 0;

    const totalTributos = iss + pis + cofins + inss + ir + csll + outras;
    const valorLiquido = valorTotal - totalTributos;

    document.getElementById('tributos-total').textContent = `R$ ${totalTributos.toFixed(2).replace('.', ',')}`;
    document.getElementById('tributos-liquido').textContent = `R$ ${valorLiquido.toFixed(2).replace('.', ',')}`;
}

// Adicionar listeners para calcular ao mudar valores
['tributos-iss', 'tributos-pis', 'tributos-cofins', 'tributos-inss', 'tributos-ir', 'tributos-csll', 'tributos-outras'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.addEventListener('input', calcularTributos);
});

document.getElementById('form-tributos')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const notaId = document.getElementById('tributos-nota-id').value;

    const tributos = {
        iss: parseFloat(document.getElementById('tributos-iss').value) || 0,
        pis: parseFloat(document.getElementById('tributos-pis').value) || 0,
        cofins: parseFloat(document.getElementById('tributos-cofins').value) || 0,
        inss: parseFloat(document.getElementById('tributos-inss').value) || 0,
        ir: parseFloat(document.getElementById('tributos-ir').value) || 0,
        csll: parseFloat(document.getElementById('tributos-csll').value) || 0,
        outras_retencoes: parseFloat(document.getElementById('tributos-outras').value) || 0
    };

    try {
        const res = await fetch(`/api/notas-fiscais/${notaId}/tributos`, {
            method: 'PUT',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({tributos})
        });

        const data = await res.json();

        if(data.success) {
            showToast('Tributos salvos com sucesso!', 'success');
            closeModalTributos();
            fetchValoresNotas();
        } else {
            showToast('Erro ao salvar tributos', 'error');
        }
    } catch(e) {
        showToast('Erro ao salvar tributos', 'error');
        console.error(e);
    }
});

// ==================== MODAL DESPESA ====================

function openModalDespesa(despesaId = null) {
    document.getElementById('despesa-id').value = despesaId || '';
    document.getElementById('modal-despesa-title').textContent = despesaId ? 'Editar Despesa' : 'Nova Despesa Operacional';

    if(despesaId) {
        // Carregar dados da despesa
        fetch(`/api/despesas/${despesaId}`)
            .then(res => res.json())
            .then(d => {
                document.getElementById('despesa-tipo').value = d.tipo;
                document.getElementById('despesa-categoria').value = d.categoria;
                document.getElementById('despesa-descricao').value = d.descricao;
                document.getElementById('despesa-valor').value = d.valor;
                document.getElementById('despesa-data').value = d.data_despesa;
                document.getElementById('despesa-fornecedor').value = d.fornecedor || '';
                document.getElementById('despesa-obs').value = d.observacoes || '';
            });
    } else {
        document.getElementById('form-despesa').reset();
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('despesa-data').value = today;
    }

    document.getElementById('modal-despesa').classList.remove('hidden');
    document.getElementById('modal-despesa').classList.add('flex');
    initIcons();
}

function closeModalDespesa() {
    document.getElementById('modal-despesa').classList.add('hidden');
    document.getElementById('modal-despesa').classList.remove('flex');
}

function editarDespesa(id) {
    openModalDespesa(id);
}

async function excluirDespesa(id) {
    if(!confirm('Tem certeza que deseja excluir esta despesa?')) return;

    try {
        const res = await fetch(`/api/despesas/${id}`, {method: 'DELETE'});
        const data = await res.json();

        if(data.success) {
            showToast('Despesa excluída com sucesso!', 'success');
            fetchValoresDespesas();
        } else {
            showToast('Erro ao excluir despesa', 'error');
        }
    } catch(e) {
        showToast('Erro ao excluir despesa', 'error');
        console.error(e);
    }
}

document.getElementById('form-despesa')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const despesaId = document.getElementById('despesa-id').value;

    const data = {
        tipo: document.getElementById('despesa-tipo').value,
        categoria: document.getElementById('despesa-categoria').value,
        descricao: document.getElementById('despesa-descricao').value,
        valor: document.getElementById('despesa-valor').value,
        data_despesa: document.getElementById('despesa-data').value,
        fornecedor: document.getElementById('despesa-fornecedor').value,
        observacoes: document.getElementById('despesa-obs').value
    };

    try {
        const url = despesaId ? `/api/despesas/${despesaId}` : '/api/despesas';
        const method = despesaId ? 'PUT' : 'POST';

        const res = await fetch(url, {
            method,
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if(result.success) {
            showToast(despesaId ? 'Despesa atualizada!' : 'Despesa cadastrada!', 'success');
            closeModalDespesa();
            fetchValoresDespesas();
        } else {
            showToast('Erro ao salvar despesa', 'error');
        }
    } catch(e) {
        showToast('Erro ao salvar despesa', 'error');
        console.error(e);
    }
});

function resetarConfiguracoes() {
    if (!confirm('Tem certeza que deseja resetar todas as configurações?')) return;

    localStorage.removeItem('empresa_logo');
    localStorage.removeItem('sistema_config');

    // Resetar formulário
    document.getElementById('cor-primaria').value = '#4f46e5';
    document.getElementById('cor-secundaria').value = '#10b981';
    document.getElementById('cor-destaque').value = '#f59e0b';
    document.getElementById('empresa-nome').value = '';
    document.getElementById('empresa-cnpj').value = '';
    document.getElementById('empresa-telefone').value = '';
    document.getElementById('empresa-email').value = '';
    document.getElementById('empresa-endereco').value = '';

    removerLogo();
    atualizarPreviewCores();

    // Remover estilos customizados
    const styleEl = document.getElementById('custom-colors');
    if (styleEl) styleEl.remove();

    showToast('Configurações resetadas!', 'info');
}

// Inicializar
document.addEventListener('DOMContentLoaded', () => {
    verificarStatusIA();
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('laudo-data').value = today;
    document.getElementById('recibo-data').value = today;
    document.getElementById('orc-data').value = today;
    if(document.getElementById('lanc-data')) {
        document.getElementById('lanc-data').value = today;
    }
    fetchClientes();

    // Carregar configurações salvas (logo e cores)
    const config = JSON.parse(localStorage.getItem('sistema_config') || '{}');
    if (config.logo) {
        atualizarLogoNavbar(config.logo);
    }
    if (config.cores) {
        aplicarCoresPersonalizadas(config.cores);
    }

    initIcons();
});
</script>

