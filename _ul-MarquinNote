function openModalBoleto(boletoId = null) {
    document.getElementById('boleto-id').value = boletoId || '';
    document.getElementById('modal-boleto-title').textContent = boletoId ? 'Editar Boleto' : 'Novo Boleto';

    if(boletoId) {
        // Carregar dados do boleto
        fetch(`/api/boletos/${boletoId}`)
            .then(res => res.json())
            .then(b => {
                document.getElementById('boleto-cliente').value = b.cliente_nome;
                document.getElementById('boleto-valor').value = b.valor;
                document.getElementById('boleto-descricao').value = b.descricao || '';
                document.getElementById('boleto-emissao').value = b.data_emissao;
                document.getElementById('boleto-vencimento').value = b.data_vencimento;
                document.getElementById('boleto-numero').value = b.numero_documento || '';
                document.getElementById('boleto-codigo').value = b.codigo_barras || '';
                document.getElementById('boleto-obs').value = b.observacoes || '';
            });
    } else {
        // Limpar formulário
        document.getElementById('form-boleto').reset();
        // Definir data de emissão como hoje
        document.getElementById('boleto-emissao').valueAsDate = new Date();
    }

    document.getElementById('modal-boleto').classList.remove('hidden');
    document.getElementById('modal-boleto').classList.add('flex');
    initIcons();
}

function closeModalBoleto() {
    document.getElementById('modal-boleto').classList.add('hidden');
    document.getElementById('modal-boleto').classList.remove('flex');
}

document.getElementById('form-boleto').onsubmit = async (e) => {
    e.preventDefault();

    const boletoId = document.getElementById('boleto-id').value;
    const dados = {
        cliente_nome: document.getElementById('boleto-cliente').value.trim(),
        valor: parseFloat(document.getElementById('boleto-valor').value),
        descricao: document.getElementById('boleto-descricao').value.trim(),
        data_emissao: document.getElementById('boleto-emissao').value,
        data_vencimento: document.getElementById('boleto-vencimento').value,
        numero_documento: document.getElementById('boleto-numero').value.trim(),
        codigo_barras: document.getElementById('boleto-codigo').value.trim()
    };

    try {
        showToast('Salvando boleto...', 'info');

        const url = boletoId ? `/api/boletos/${boletoId}` : '/api/boletos';
        const method = boletoId ? 'PUT' : 'POST';

        const res = await fetch(url, {
            method: method,
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(dados)
        });

        if(res.ok) {
            showToast('Boleto salvo com sucesso!', 'success');
            closeModalBoleto();
            fetchBoletos();
        } else {
            const error = await res.json();
            showToast(error.error || 'Erro ao salvar boleto', 'error');
        }
    } catch(e) {
        showToast('Erro ao salvar boleto', 'error');
        console.error(e);
    }
};

async function pagarBoleto(boletoId) {
    const dataPagamento = prompt('Data do pagamento (AAAA-MM-DD):', new Date().toISOString().split('T')[0]);
    if(!dataPagamento) return;

    const valorPago = prompt('Valor pago (deixe vazio se igual ao valor do boleto):');

    try {
        showToast('Marcando como pago...', 'info');

        const res = await fetch(`/api/boletos/${boletoId}/pagar`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                data_pagamento: dataPagamento,
                valor_pago: valorPago ? parseFloat(valorPago) : null
            })
        });

        if(res.ok) {
            showToast('Boleto marcado como pago!', 'success');
            fetchBoletos();
        } else {
            showToast('Erro ao marcar boleto como pago', 'error');
        }
    } catch(e) {
        showToast('Erro ao processar pagamento', 'error');
        console.error(e);
    }
}

