let chartInstances = {}; // Armazenar instâncias dos gráficos

function destruirGrafico(id) {
    if (chartInstances[id]) {
        chartInstances[id].destroy();
        delete chartInstances[id];
    }
}

function renderizarGrafico(dados) {
    if(!dados || dados.length === 0) {
        console.warn('Nenhum dado disponível para gráficos');
        return;
    }

    // Preparar dados
    const dadosRevertidos = [...dados].reverse();
    const meses = dadosRevertidos.map(d => {
        const [ano, mes] = d.mes.split('-');
        const mesesNomes = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
        return `${mesesNomes[parseInt(mes)-1]}/${ano.substr(2)}`;
    });
    const valores = dadosRevertidos.map(d => d.total_valor || 0);

    // Calcular KPIs
    calcularKPIs(valores);

    // Renderizar todos os gráficos
    renderizarGraficoFaturamento(meses, valores);
    renderizarGraficoPizza();
    renderizarGraficoTopClientes();
    renderizarGraficoComparativo(meses);
    renderizarGraficoHeatmap();
}

