{
  "name": "gestao-documentos",
  "version": "2.0.0",
  "description": "Sistema de Gestao de Documentos - Dedetizadora Borges",
  "scripts": {
    "build:css": "npx tailwindcss -i ./static/src/input.css -o ./static/css/styles.min.css --minify",
    "watch:css": "npx tailwindcss -i ./static/src/input.css -o ./static/css/styles.min.css --watch",
    "dev:react": "vite --config vite.config.js",
    "build:react": "vite build --config vite.config.js",
    "build": "npm run build:css && npm run build:react"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0"
  }
}
