  "numeroOS": "2024/0123",
  "data": "12/01/2024",
  "dataExtenso": "doze de janeiro de dois mil e vinte e quatro",
  "horarioInicio": "08:30",
  "horarioTermino": "11:45",
  "tipoServico": "Dedetização e Desratização Completa",
  "responsavelTecnico": "Carlos Eduardo Santos",
  "numeroRegistro": "CREA-SP 5062345678",

  "tipoImovel": "Comercial - Loja de Alimentos",
  "area": "350m²",
  "pavimentos": "2 pavimentos + subsolo",
  "descricaoLocal": "Estabelecimento comercial de venda de alimentos, com área de armazenamento no subsolo, salão de vendas no térreo e escritório administrativo no primeiro andar.",

  "pragas": [
    {
      "nome": "Baratas (Blatella germanica)",
      "nivel": "Alto",
      "localizacao": "Cozinha, despensa e área de armazenamento"
    },
    {
      "nome": "Formigas (Monomorium pharaonis)",
      "nivel": "Médio",
      "localizacao": "Área de expedição e corredores"
    },
    {
      "nome": "Ratos (Rattus norvegicus)",
      "nivel": "Baixo",
      "localizacao": "Subsolo e área externa"
    }
  ],

  "produtos": [
    {
      "nome": "K-Othrine SC 250",
      "principioAtivo": "Deltametrina 2,5%",
      "concentracao": "2,5%",
      "quantidade": "750ml",
      "registroAnvisa": "3019900106",
      "classe": "Classe II - Altamente Tóxico"
    },
    {
      "nome": "Maxforce Quantum Gel",
      "principioAtivo": "Imidacloprida 0,03%",
      "concentracao": "0,03%",
      "quantidade": "60g (2 seringas)",
      "registroAnvisa": "3029900189",
      "classe": "Classe III - Medianamente Tóxico"
    },
    {
      "nome": "Klerat Bloco",
      "principioAtivo": "Brodifacoum 0,005%",
      "concentracao": "0,005%",
      "quantidade": "500g (10 blocos de 50g)",
      "registroAnvisa": "3029900192",
      "classe": "Classe I - Extremamente Tóxico"
    }
  ],

  "metodologiaAplicacao": "Foi realizada aplicação por pulverização com equipamento costal nas áreas de maior incidência de baratas, aplicação de gel inseticida em pontos estratégicos (frestas, tomadas, cantos) e instalação de iscas raticidas em caixas porta-iscas nas áreas de circulação de roedores.",
  "equipamentosUtilizados": "Pulverizador costal de precisão 20L, aplicador de gel profissional, caixas porta-iscas em PVC",
  "concentracao": "1:50 (20ml de produto para 1L de água)",
  "volumeCalda": "15 litros de calda preparada",

  "observacoes": "Durante todo o procedimento, a área foi isolada e mantida livre de pessoas e animais domésticos. A aplicação foi realizada em condições climáticas favoráveis (temperatura entre 20-25°C, sem chuva). O cliente foi orientado sobre os procedimentos de segurança e cuidados pós-aplicação.",

  "recomendacoes": "1. Manter os ambientes bem ventilados por no mínimo 3 horas após a aplicação.\n2. Evitar limpeza com água nas áreas tratadas por 10 dias.\n3. Não remover as caixas porta-iscas instaladas.\n4. Manter alimentos bem armazenados em recipientes fechados.\n5. Realizar limpeza de resíduos e restos de alimentos diariamente.\n6. Vedar frestas e aberturas que possam servir de abrigo para pragas.",

  "proximaVisita": "12/02/2024",

  "periodoGarantia": "90 dias a partir da data do serviço",
  "condicoesGarantia": "A garantia é válida mediante cumprimento integral das recomendações técnicas e condições contratuais. A garantia cobre retorno do serviço em caso de reinfestação das pragas tratadas.",

  "nomeResponsavel": "Carlos Eduardo Santos",
  "assinaturaPath": "",
  "carimboPath": ""
}

