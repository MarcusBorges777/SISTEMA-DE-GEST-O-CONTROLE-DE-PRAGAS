### 5. Gerar Laudo de Caixa D'Água
POST http://localhost:8080/api/documentos/laudo-caixa-agua?comAssinatura=false
Content-Type: application/json

{
  "nomeCliente": "Edifício Comercial Torre Business",
  "cnpjCpf": "67.890.123/0001-55",
  "enderecoCliente": "Av. Paulista, 1500",
  "bairroCliente": "Bela Vista",
  "cidadeCliente": "São Paulo - SP",
  "cepCliente": "01310-100",
  "telefoneCliente": "(11) 4455-6677",
  "emailCliente": "administracao@torrebus.com.br",

  "numeroOS": "2024/0125",
  "data": "16/01/2024",
  "dataExtenso": "dezesseis de janeiro de dois mil e vinte e quatro",
  "horarioInicio": "06:00",
  "horarioTermino": "10:30",
  "tipoServico": "Limpeza e Desinfecção de Reservatórios de Água",
  "responsavelTecnico": "Roberto Alves Ferreira",
  "numeroRegistro": "CREA-SP 5063456789",

  "tipoImovel": "Comercial - Edifício Corporativo",
  "area": "N/A",
  "pavimentos": "25 andares",
  "descricaoLocal": "Edifício comercial com 25 andares, 4 reservatórios de água (2 inferiores de 15.000L cada e 2 superiores de 10.000L cada), totalizando 50.000 litros de capacidade.",

  "pragas": [],

  "produtos": [
    {
      "nome": "Hipoclorito de Sódio 10%",
      "principioAtivo": "Hipoclorito de Sódio",
      "concentracao": "10%",
      "quantidade": "2 litros",
      "registroAnvisa": "Produto saneante - MS 3.02450.0.001",
      "classe": "Saneante"
    },
    {
      "nome": "Detergente Neutro Biodegradável",
      "principioAtivo": "Tensoativos biodegradáveis",
      "concentracao": "N/A",
      "quantidade": "1 litro",
      "registroAnvisa": "Produto de limpeza",
      "classe": "N/A"
    }
  ],

  "metodologiaAplicacao": "1. Fechamento de registros e esvaziamento completo dos reservatórios\n2. Remoção manual de resíduos sólidos e lodo\n3. Lavagem com detergente neutro e escovação de paredes, fundo e tampa\n4. Enxágue completo com água limpa\n5. Desinfecção com solução de hipoclorito de sódio (200ppm)\n6. Tempo de contato de 2 horas\n7. Enxágue final até remoção completo do cloro residual\n8. Enchimento dos reservatórios com água tratada\n9. Cloração final (0,5 a 2,0 ppm de cloro residual livre)",

  "equipamentosUtilizados": "Escovas de cerdas duras, rodos, baldes, bomba d'água, EPIs completos (luvas, botas, máscara, óculos)",
  "concentracao": "200ppm de cloro ativo para desinfecção (20ml de hipoclorito 10% por 100L de água)",
  "volumeCalda": "100 litros de solução desinfetante",

  "observacoes": "• Todos os 4 reservatórios foram limpos e desinfetados\n• Inspeção visual realizada: não foram encontradas rachaduras, vazamentos ou pontos de corrosão\n• Tampas dos reservatórios em bom estado de conservação\n• Telas de proteção contra insetos presentes e em bom estado\n• Bóias e torneiras de entrada funcionando corretamente\n• Nível de cloro residual livre após o serviço: 0,8 ppm (dentro do padrão: 0,5 a 2,0 ppm)\n• Água apta para consumo após o serviço",

  "recomendacoes": "1. Realizar limpeza e desinfecção a cada 6 meses (conforme Portaria MS 2.914/2011)\n2. Manter as tampas sempre bem fechadas\n3. Verificar mensalmente as condições das telas de proteção\n4. Realizar análise da qualidade da água trimestralmente\n5. Agendar próxima limpeza para julho/2024",

  "proximaVisita": "16/07/2024",

  "periodoGarantia": "30 dias para o serviço executado",
  "condicoesGarantia": "Garantia de execução conforme normas sanitárias vigentes",

  "nomeResponsavel": "Roberto Alves Ferreira"
}

